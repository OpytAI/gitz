    name = "local_repo.wasm",
    main = "local_repo.zig",
    srcs = ["abi.zig"],
    zigopts = [
        "-fno-entry",
        "-rdynamic",
        "-fsingle-threaded",
    ],
    deps = [
        "//src/fs",
        "//src/plumbing",
        "//src/plumbing/object",
