load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_configure_binary")

package(default_visibility = ["//visibility:public"])

test_suite(
    name = "all",
    tests = [
        ":local_repo_test",
        ":local_repo_debug_test",
        ":pack_import_test",
        ":pack_import_debug_test",
        ":pack_build_test",
        ":pack_build_debug_test",
        ":persistence_test",
        ":persistence_debug_test",
        ":engine_smoke_test",
        ":engine_smoke_debug_test",
    ],
)

test_suite(
    name = "release",
    tests = [
        ":local_repo_test",
        ":pack_import_test",
        ":pack_build_test",
        ":persistence_test",
        ":engine_smoke_test",
    ],
)

test_suite(
    name = "debug",
    tests = [
        ":local_repo_debug_test",
        ":pack_import_debug_test",
        ":pack_build_debug_test",
        ":persistence_debug_test",
        ":engine_smoke_debug_test",
    ],
)

zig_binary(
    name = "probe.wasm",
    main = "probe.zig",
    zigopts = [
        "-fno-entry",
        "-rdynamic",
        "-fsingle-threaded",
    ],
    deps = ["//src/crypto/sha1cd"],
)

zig_configure_binary(
    name = "probe",
    actual = ":probe.wasm",
    mode = "release_small",
    target = "//platforms:wasm32_freestanding",
)

