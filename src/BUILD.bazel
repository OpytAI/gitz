load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

# Core library root — re-exports foundation + phase 2–4 packages.
zig_library(
    name = "gitz",
    main = "root.zig",
    visibility = ["//visibility:public"],
    deps = [
        "//src/plumbing",
        "//src/plumbing/hash",
        "//src/plumbing/filemode",
        "//src/plumbing/color",
        "//src/plumbing/format/pktline",
        "//src/plumbing/format/objfile",
        "//src/plumbing/format/config",
        "//src/plumbing/format/idxfile",
        "//src/plumbing/format/packfile",
        "//src/plumbing/format/index",
        "//src/plumbing/storer",
        "//src/plumbing/cache",
        "//src/storage",
        "//src/storage/memory",
        "//src/utils/binary",
        "//src/utils/sync",
        "//src/utils/ioutil",
        "//src/utils/trace",
    ],
)

zig_test(
    name = "gitz_test",
    main = "root.zig",
    deps = [
        "//src/plumbing",
        "//src/plumbing/hash",
        "//src/plumbing/filemode",
        "//src/plumbing/color",
        "//src/plumbing/format/pktline",
        "//src/plumbing/format/objfile",
        "//src/plumbing/format/config",
        "//src/plumbing/format/idxfile",
        "//src/plumbing/format/packfile",
        "//src/plumbing/format/index",
        "//src/plumbing/storer",
        "//src/plumbing/cache",
        "//src/storage",
        "//src/storage/memory",
        "//src/utils/binary",
        "//src/utils/sync",
        "//src/utils/ioutil",
        "//src/utils/trace",
    ],
)

# Full src tree for file/API inventory checkers.
# Note: Bazel package borders mean parent globs do not see child packages.
filegroup(
    name = "src_tree",
    srcs = glob(
        ["*"],
        allow_empty = True,
    ) + [
        "//src/plumbing:package_srcs",
        "//src/plumbing/hash:package_srcs",
        "//src/plumbing/filemode:package_srcs",
        "//src/plumbing/color:package_srcs",
        "//src/plumbing/format/pktline:package_srcs",
        "//src/plumbing/format/objfile:package_srcs",
        "//src/plumbing/format/config:package_srcs",
        "//src/plumbing/format/idxfile:package_srcs",
        "//src/plumbing/format/packfile:package_srcs",
        "//src/plumbing/format/index:package_srcs",
        "//src/plumbing/storer:package_srcs",
        "//src/plumbing/cache:package_srcs",
        "//src/storage:package_srcs",
        "//src/storage/memory:package_srcs",
        "//src/crypto/sha1cd:package_srcs",
        "//src/utils/binary:package_srcs",
        "//src/utils/sync:package_srcs",
        "//src/utils/ioutil:package_srcs",
        "//src/utils/trace:package_srcs",
    ],
    visibility = ["//visibility:public"],
)
