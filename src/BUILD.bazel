load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

# Core library root. Subpackages (plumbing/, storage/, …) will be added as the port grows.
zig_library(
    name = "gitz",
    main = "root.zig",
    visibility = ["//visibility:public"],
)

# Unit tests embedded in root.zig (and later package tests).
zig_test(
    name = "gitz_test",
    main = "root.zig",
)

# Full src tree for file/API inventory checkers (//check:*).
filegroup(
    name = "src_tree",
    srcs = glob(
        ["**/*"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
