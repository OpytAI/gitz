load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

# go-git root prune.go + object_walker.go — loose object prune.
_SRCS = [
    "object_walker.zig",
    "prune.zig",
]

_DEPS = [
    "//src/plumbing",
    "//src/plumbing/filemode",
    "//src/plumbing/object",
    "//src/storage/memory",
]

zig_library(
    name = "prune",
    main = "root.zig",
    srcs = _SRCS,
    import_name = "prune",
    visibility = ["//visibility:public"],
    deps = _DEPS,
)

zig_test(
    name = "prune_test",
    size = "small",
    main = "root.zig",
    srcs = _SRCS,
    deps = _DEPS,
)

filegroup(
    name = "package_srcs",
    srcs = glob(["**/*"]),
    visibility = ["//visibility:public"],
)
