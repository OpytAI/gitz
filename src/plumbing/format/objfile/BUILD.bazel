load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

# go-git plumbing/format/objfile — loose object zlib encode/decode.
zig_library(
    name = "objfile",
    main = "root.zig",
    srcs = [
        "error.zig",
        "fixtures.zig",
        "reader.zig",
        "writer.zig",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//src/plumbing",
        "//src/utils/sync",
    ],
)

zig_test(
    name = "objfile_test",
    size = "small",
    main = "root.zig",
    srcs = [
        "error.zig",
        "fixtures.zig",
        "reader.zig",
        "writer.zig",
    ],
    deps = [
        "//src/plumbing",
        "//src/utils/sync",
    ],
)

# Sources for //check file/API inventory (parent globs do not cross package borders).
filegroup(
    name = "package_srcs",
    srcs = glob(["**/*"]),
    visibility = ["//visibility:public"],
)
