load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

# go-git plumbing/format/packfile — pack read + write (phase 5 encoder).
# Fixture embeds (*.pack / *.idx as .zig) are package-local for unit tests;
# human-owned binaries live under data/fixtures/packfile/.
_SRCS = [
    "error.zig",
    "common.zig",
    "scanner.zig",
    "patch_delta.zig",
    "parser.zig",
    "packfile.zig",
    "object_to_pack.zig",
    "delta_index.zig",
    "diff_delta.zig",
    "delta_selector.zig",
    "encoder.zig",
    "encoder_advanced.zig",
    "basic_pack.zig",
    "ref_delta_pack.zig",
    "ref_delta_idx.zig",
    "delta_before_base_pack.zig",
    "thinpack_pack.zig",
    "codecommit_pack.zig",
    "thin_pack_tests.zig",
]

zig_library(
    name = "packfile",
    main = "root.zig",
    srcs = _SRCS,
    visibility = ["//visibility:public"],
    deps = [
        "//src/plumbing",
        "//src/plumbing/hash",
        "//src/plumbing/format/idxfile",
        "//src/utils/binary",
        "//src/utils/sync",
        "//src/utils/ioutil",
    ],
)

zig_test(
    name = "packfile_test",
    # Deep delta-chain tests build ~4k objects; allow medium timeout.
    size = "medium",
    main = "root.zig",
    srcs = _SRCS,
    deps = [
        "//src/plumbing",
        "//src/plumbing/hash",
        "//src/plumbing/format/idxfile",
        "//src/utils/binary",
        "//src/utils/sync",
        "//src/utils/ioutil",
    ],
)

filegroup(
    name = "package_srcs",
    srcs = glob(["**/*"]),
    visibility = ["//visibility:public"],
)
