load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

# go-git plumbing/transport/server — in-process upload-pack / receive-pack.
_LIB_SRCS = [
    "loader.zig",
    "server.zig",
]

zig_library(
    name = "server",
    main = "root.zig",
    srcs = _LIB_SRCS,
    import_name = "server",
    visibility = ["//visibility:public"],
    deps = [
        "//src/plumbing",
        "//src/plumbing/transport",
        "//src/plumbing/protocol/packp",
        "//src/plumbing/protocol/packp/capability",
        "//src/plumbing/protocol/packp/sideband",
        "//src/plumbing/storer",
        "//src/plumbing/revlist",
        "//src/plumbing/format/packfile",
        "//src/plumbing/cache",
        "//src/storage/memory",
        "//src/storage/filesystem",
        "//src/fs",
        "//src/utils/ioutil",
        "//src/utils/sync",
    ],
)

# Unit tests: separate main so production root never imports fixtures.
zig_test(
    name = "server_test",
    size = "small",
    main = "server_test_root.zig",
    srcs = _LIB_SRCS + [
        "root.zig",
        "server_test.zig",
        "server_test_root.zig",
    ],
    deps = [
        "//src/plumbing",
        "//src/plumbing/transport",
        "//src/plumbing/transport/test:fixtures",
        "//src/plumbing/protocol/packp",
        "//src/plumbing/protocol/packp/capability",
        "//src/plumbing/protocol/packp/sideband",
        "//src/plumbing/storer",
        "//src/plumbing/revlist",
        "//src/plumbing/format/packfile",
        "//src/plumbing/cache",
        "//src/storage/memory",
        "//src/storage/filesystem",
        "//src/fs",
        "//src/utils/ioutil",
        "//src/utils/sync",
    ],
)

filegroup(
    name = "package_srcs",
    srcs = glob(["**/*"]),
    visibility = ["//visibility:public"],
)
