load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

# go-git plumbing/transport/git — git:// TCP transport.
# common_test.zig is part of the library (imported from root test block) so
# //src:gitz_test can resolve the import. e2e_test.zig stays test-only (heavy deps).
_LIB_SRCS = [
    "common.zig",
    "common_test.zig",
]

_TEST_SRCS = _LIB_SRCS + [
    "root.zig",
    "e2e_test.zig",
]

zig_library(
    name = "git",
    main = "root.zig",
    srcs = _LIB_SRCS,
    import_name = "transport_git",
    visibility = ["//visibility:public"],
    deps = [
        "//src/plumbing/transport",
        "//src/plumbing/transport/internal/common",
        "//src/plumbing/protocol/packp",
    ],
)

# Live git-daemon e2e needs localhost TCP + host `git` binary.
zig_test(
    name = "git_test",
    size = "small",
    main = "test_root.zig",
    srcs = _TEST_SRCS,
    tags = [
        "requires-network",
    ],
    deps = [
        "//src/plumbing",
        "//src/plumbing/transport",
        "//src/plumbing/transport/internal/common",
        "//src/plumbing/transport/server",
        "//src/plumbing/transport/test:fixtures",
        "//src/plumbing/protocol/packp",
        "//src/plumbing/protocol/packp/capability",
        "//src/storage/memory",
        "//src/utils/sync",
    ],
)

filegroup(
    name = "package_srcs",
    srcs = glob(["**/*"]),
    visibility = ["//visibility:public"],
)
