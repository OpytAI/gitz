load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

# go-git plumbing/object — logical Blob/Tree/Commit/Tag + walkers.
_SRCS = [
    "error.zig",
    "signature.zig",
    "blob.zig",
    "file.zig",
    "tree.zig",
    "commit.zig",
    "tag.zig",
    "object.zig",
    "commit_walker.zig",
    "merge_base.zig",
    "change.zig",
    "tree_noder.zig",
    "change_adaptor.zig",
    "difftree.zig",
    "rename.zig",
    "similarity.zig",
    "patch.zig",
    "openpgp.zig",
]

_DEPS = [
    "//src/plumbing",
    "//src/plumbing/filemode",
    "//src/plumbing/format/diff",
    "//src/plumbing/storer",
    "//src/storage/memory",
    "//src/utils/diff",
    "//src/utils/merkletrie",
    "//src/utils/merkletrie/noder",
    "//src/utils/sync",
]

zig_library(
    name = "object",
    main = "root.zig",
    srcs = _SRCS,
    import_name = "object",
    visibility = ["//visibility:public"],
    deps = _DEPS,
)

zig_test(
    name = "object_test",
    size = "small",
    main = "root.zig",
    srcs = _SRCS,
    deps = _DEPS,
)

filegroup(
    name = "package_srcs",
    srcs = glob(
        ["**/*"],
        exclude = ["commitgraph/**"],
    ),
    visibility = ["//visibility:public"],
)
