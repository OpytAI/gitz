load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

# go-git plumbing/serverinfo — UpdateServerInfo (dumb HTTP info/refs + packs).
_SRCS = [
    "serverinfo.zig",
]

_DEPS = [
    "//src/plumbing",
    "//src/plumbing/object",
    "//src/internal/reference",
    "//src/storage/memory",
    "//src/fs",
]

zig_library(
    name = "serverinfo",
    main = "root.zig",
    srcs = _SRCS,
    import_name = "serverinfo",
    visibility = ["//visibility:public"],
    deps = _DEPS,
)

zig_test(
    name = "serverinfo_test",
    size = "small",
    main = "root.zig",
    srcs = _SRCS,
    deps = _DEPS,
)

filegroup(
    name = "package_srcs",
    srcs = glob(["**/*"]),
    visibility = ["//visibility:public"],
)
