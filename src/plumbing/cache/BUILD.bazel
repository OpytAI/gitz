load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

# go-git plumbing/cache — ObjectLRU + BufferLRU + shared FileSize units.
_SRCS = [
    "common.zig",
    "object_lru.zig",
    "buffer_lru.zig",
]

zig_library(
    name = "cache",
    main = "root.zig",
    srcs = _SRCS,
    visibility = ["//visibility:public"],
    deps = [
        "//src/plumbing",
    ],
)

zig_test(
    name = "cache_test",
    size = "small",
    main = "root.zig",
    srcs = _SRCS,
    deps = [
        "//src/plumbing",
    ],
)

# Sources for //check file/API inventory (parent globs do not cross package borders).
filegroup(
    name = "package_srcs",
    srcs = glob(["**/*"]),
    visibility = ["//visibility:public"],
)
