load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

# go-git internal/pathutil — NTFS/HFS path security and ValidTreePath.
zig_library(
    name = "pathutil",
    main = "root.zig",
    srcs = [
        "dotgit.zig",
        "hfs.zig",
        "ntfs.zig",
        "tree.zig",
    ],
    import_name = "pathutil",
    visibility = ["//visibility:public"],
)

zig_test(
    name = "pathutil_test",
    size = "small",
    main = "root.zig",
    srcs = [
        "dotgit.zig",
        "hfs.zig",
        "ntfs.zig",
        "tree.zig",
    ],
)

# Sources for //check file/API inventory (parent globs do not cross package borders).
filegroup(
    name = "package_srcs",
    srcs = glob(["**/*"]),
    visibility = ["//visibility:public"],
)
