load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

# go-git internal/reference — sort references by name for stable order.
zig_library(
    name = "reference",
    import_name = "internal_reference",
    main = "root.zig",
    srcs = [
        "sort.zig",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//src/plumbing",
    ],
)

zig_test(
    name = "reference_test",
    size = "small",
    main = "root.zig",
    srcs = [
        "sort.zig",
    ],
    deps = [
        "//src/plumbing",
    ],
)

# Sources for //check file/API inventory (parent globs do not cross package borders).
filegroup(
    name = "package_srcs",
    srcs = glob(["**/*"]),
    visibility = ["//visibility:public"],
)
