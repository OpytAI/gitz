load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

# go-git internal/path_util — tilde expansion for home-relative paths.
zig_library(
    name = "path_util",
    main = "root.zig",
    import_name = "path_util",
    visibility = ["//visibility:public"],
)

zig_test(
    name = "path_util_test",
    size = "small",
    main = "root.zig",
)

# Sources for //check file/API inventory (parent globs do not cross package borders).
filegroup(
    name = "package_srcs",
    srcs = glob(["**/*"]),
    visibility = ["//visibility:public"],
)
