load("@rules_zig//zig:defs.bzl", "zig_library", "zig_test")

_SRCS = [
    "error.zig",
    "clone.zig",
]

_DEPS = [
    "//src/plumbing",
    "//src/plumbing/object",
    "//src/plumbing/storer",
    "//src/storage/memory",
    "//src/fs",
    "//src/config",
    "//src/remote",
    "//src/repo",
    "//src/worktree",
    "//src/plumbing/transport/server",
    "//src/utils/sync",
]

zig_library(
    name = "porcelain",
    main = "root.zig",
    srcs = _SRCS,
    import_name = "porcelain",
    visibility = ["//visibility:public"],
    deps = _DEPS,
)

zig_test(
    name = "porcelain_test",
    size = "medium",
    main = "test_root.zig",
    srcs = _SRCS + [
        "root.zig",
        "tests.zig",
        "test_root.zig",
    ],
    deps = _DEPS + [
        "//src/plumbing/transport/test:fixtures",
        "//src/plumbing/transport/client",
    ],
)

filegroup(
    name = "package_srcs",
    srcs = glob(["**/*"]),
    visibility = ["//visibility:public"],
)
