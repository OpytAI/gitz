# Phase 7: logical objects, commitgraph, revlist.
test_suite(
    name = "phase_7_packages",
    tests = [
        "//src/plumbing/object:object_test",
        "//src/plumbing/format/commitgraph:commitgraph_test",
        "//src/plumbing/object/commitgraph:object_commitgraph_test",
        "//src/plumbing/revlist:revlist_test",
    ],
)

test_suite(
    name = "phase_7",
    tests = [
        ":phase_6",
        ":phase_7_packages",
    ],
)

test_suite(
    name = "phase_8",
    tests = [":phase_7"],
)

test_suite(
    name = "phase_9",
    tests = [":phase_8"],
)

test_suite(
    name = "phase_10",
    tests = [":phase_9"],
)

test_suite(
    name = "phase_11",
