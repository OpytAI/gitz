    tests = [
        "//src/plumbing/storer:storer_test",
        "//src/plumbing/cache:cache_test",
        "//src/storage:storage_test",
        "//src/storage:suite_test",
        "//src/storage/memory:memory_test",
    ],
)

test_suite(
    name = "phase_4",
    tests = [
        ":phase_3",
        ":phase_4_packages",
