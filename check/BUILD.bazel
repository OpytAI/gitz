# Guardrail targets (Phase G). Acceptance after G is only via bazel test //check:...

package(default_visibility = ["//visibility:public"])

# Shared data for inventory / golden checkers.
filegroup(
    name = "check_data",
    srcs = [
        "//inventories:all",
        "//tools/golden:all",
        "//tools/inventory:all",
        "//data:all",
        "//src:src_tree",
        "//:GO_GIT_PIN.md",
    ],
)

# Shell entrypoints + runfiles_env must appear together under //check in runfiles.
CHECK_SCRIPTS = [
    "runfiles_env.sh",
    "file_inventory.sh",
    "api_inventory.sh",
    "metrics.sh",
    "allowlists.sh",
    "goldens_smoke.sh",
    "self_tests.sh",
    "file_inventory_fail_forward.sh",
    "api_inventory_fail_forward.sh",
]

exports_files(CHECK_SCRIPTS)

sh_test(
    name = "file_inventory",
    size = "small",
    srcs = ["file_inventory.sh"],
    data = CHECK_SCRIPTS + [":check_data"],
)

sh_test(
    name = "api_inventory",
    size = "small",
    srcs = ["api_inventory.sh"],
    data = CHECK_SCRIPTS + [":check_data"],
)

sh_test(
    name = "goldens_smoke",
    size = "small",
    srcs = ["goldens_smoke.sh"],
    data = CHECK_SCRIPTS + [":check_data"],
)

sh_test(
    name = "metrics",
    size = "small",
    srcs = ["metrics.sh"],
    data = CHECK_SCRIPTS + [":check_data"],
)

sh_test(
    name = "allowlists",
    size = "small",
    srcs = ["allowlists.sh"],
    data = CHECK_SCRIPTS + [":check_data"],
)

sh_test(
    name = "checker_self_tests",
    size = "small",
    srcs = ["self_tests.sh"],
    data = CHECK_SCRIPTS + [":check_data"],
)

# Fixture fail-forward (negative): frozen data/fail_forward/* + hollow fixture src.
# Does not depend on live inventories/packages.yaml or production src/.
sh_test(
    name = "file_inventory_fail_forward",
    size = "small",
    srcs = ["file_inventory_fail_forward.sh"],
    data = CHECK_SCRIPTS + [":check_data"],
)

sh_test(
    name = "api_inventory_fail_forward",
    size = "small",
    srcs = ["api_inventory_fail_forward.sh"],
    data = CHECK_SCRIPTS + [":check_data"],
)

# Phase G gate: inventories + goldens + metrics + fail-forward + library smoke.
# Fixture generators that are part of the hermetic graph are pulled in by later
# phase suites (e.g. //tools:gen_index_fixtures_test under phase_5).
test_suite(
    name = "phase_g",
    tests = [
        ":file_inventory",
        ":api_inventory",
        ":goldens_smoke",
        ":metrics",
        ":allowlists",
        ":checker_self_tests",
        ":file_inventory_fail_forward",
        ":api_inventory_fail_forward",
        "//src:gitz_test",
    ],
)

# Phase 1–13 stubs. Green //check:phase_N alone is NOT proof of phase-N packages.
# Merge-complete means: suite green AND inventories/packages.yaml current_phase
# bumped so file/api inventory require non-hollow packages for phase <= N.
# Expand each suite with package unit tests as phases land.
# Phase 1 foundation package unit tests + gate bundle.
test_suite(
    name = "phase_1_packages",
    tests = [
        "//src/plumbing:plumbing_test",
        "//src/plumbing/hash:hash_test",
        "//src/plumbing/filemode:filemode_test",
        "//src/plumbing/color:color_test",
        "//src/utils/binary:binary_test",
        "//src/utils/sync:sync_test",
        "//src/utils/ioutil:ioutil_test",
        "//src/utils/trace:trace_test",
    ],
)

test_suite(
    name = "phase_1",
    tests = [
        ":phase_g",
        ":phase_1_packages",
    ],
)

# Phase 2 leaf codecs.
test_suite(
    name = "phase_2_packages",
    tests = [
        "//src/plumbing/format/pktline:pktline_test",
        "//src/plumbing/format/objfile:objfile_test",
        "//src/plumbing/format/config:config_test",
        "//src/plumbing/format/idxfile:idxfile_test",
    ],
)

test_suite(
    name = "phase_2",
    tests = [
        ":phase_1",
        ":phase_2_packages",
    ],
)

# Phase 3 packfile read path.
test_suite(
    name = "phase_3_packages",
    tests = [
        "//src/plumbing/format/packfile:packfile_test",
    ],
)

test_suite(
    name = "phase_3",
    tests = [
        ":phase_2",
        ":phase_3_packages",
    ],
)

# Phase 4 storer contracts + cache + storage/memory.
test_suite(
